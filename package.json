{
  "name": "@morpho-org/morpho-bots",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @repo/contracts run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix --no-error-on-unmatched-pattern",
    "prepare": "husky",
    "test": "bun test"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^24.14.1"
  },
  "packageManager": "pnpm@11.1.1"
}
