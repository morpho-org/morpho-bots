{
  "name": "@repo/midnight-liquidation",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./soltag-plugin": {
      "types": "./soltag.plugin.ts",
      "default": "./soltag.plugin.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript https://api.morpho.org/markets/docs/swagger/json -o ./src/generated/markets-api.ts && openapi-typescript https://api.morpho.org/midnight/docs/swagger/json -o ./src/generated/midnight-api.ts",
    "seed:positions": "bun run scripts/seed-liquidatable-positions.ts",
    "typecheck": "soltag && tsc --noEmit"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/evm-kit": "workspace:*",
    "@repo/pipeline": "workspace:*",
    "@repo/swaps": "workspace:*",
    "@repo/utils": "workspace:*",
    "executooor-viem": "catalog:",
    "openapi-fetch": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:"
  }
}
