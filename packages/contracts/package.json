{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "bun run scripts/codegen.ts && oxfmt src/abis.ts src/contracts.ts",
    "build": "soltag && bun run scripts/build.ts && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "soltag && tsc --noEmit",
    "format:sol": "forge fmt",
    "format:sol:check": "forge fmt --check"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "typescript": "catalog:"
  }
}
