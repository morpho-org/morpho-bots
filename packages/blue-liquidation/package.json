{
  "name": "@repo/blue-liquidation",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/bot.ts",
      "default": "./src/bot.ts"
    }
  },
  "scripts": {
    "probe:lens": "bun run scripts/probe-live-lens.ts",
    "prestart": "bun run --parallel --workspaces --if-present build",
    "start": "bun src/index.ts",
    "typecheck": "soltag && tsc --noEmit"
  },
  "dependencies": {
    "@repo/bot-kit": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/swaps": "workspace:*",
    "@repo/utils": "workspace:*",
    "executooor-viem": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
