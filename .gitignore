# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnpm-store

# Local env files
.env
.env.*
!.env.example

# Local quoter-bot configuration (examples remain trackable)
**/quoter-bot.yaml
**/quoter-bot.yml
!**/quoter-bot.example.yaml
!**/quoter-bot.example.yml

# Legacy local configuration can still contain private keys after upgrading.
**/market-making.yaml
**/market-making.yml
!**/market-making.example.yaml
!**/market-making.example.yml


# Testing
coverage

# Build Outputs
build
dist

# Debug
*.log

# Misc
.DS_Store
*.pem

# tsbuildinfo
**/*.tsbuildinfo

# soltag generated ABI-type augmentation (regenerated by the `soltag` CLI before typecheck)
**/.soltag

# IDE preferences
.idea

# Claude settings (local overrides only)
.claude/settings.local.json
# Anchored (leading slash — identical meaning for git, since slash-containing
# patterns are already root-relative) so knip does not convert this line into the
# unanchored glob **/.claude/worktrees/**, which also matches the ABSOLUTE path of
# an agent worktree checked out under .claude/worktrees/ and silently drops its
# package.json script entries when `pnpm knip` runs from inside one.
/.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/agent-memory/
