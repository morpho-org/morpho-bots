{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": ["enumMembers", "classMembers"],
  "includeEntryExports": true,
  "ignore": [".claude/**"],
  "ignoreBinaries": ["forge", "railway"],
  "workspaces": {
    ".": {},
    "packages/typescript-config": {},
    "packages/utils": {},
    // Consumers resolve this package through its gitignored `dist`, so knip reads every entry
    // export as unused.
    "packages/contracts": {
      "includeEntryExports": false
    },
    "packages/bot-kit": {},
    "packages/swaps": {},
    "bots/midnight-liquidation": {
      "ignore": ["src/generated/**"]
    },
    "bots/blue-liquidation": {},
    "bots/midnight-crossed-books": {
      "ignore": ["src/infrastructure/*/generated/**"]
    },
    "bots/monitor-bot": {
      "ignore": ["src/generated/**"]
    }
  }
}
