{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": ["enumMembers", "classMembers"],
  "ignore": [".claude/**"],
  "ignoreBinaries": ["forge", "railway"],
  "workspaces": {
    ".": {},
    "packages/typescript-config": {},
    "packages/utils": {},
    "packages/contracts": {
      "entry": ["src/index.ts", "scripts/*.ts"]
    },
    "packages/bot-kit": {},
    "packages/swaps": {},
    "bots/midnight-liquidation": {
      "entry": ["src/index.ts", "scripts/*.ts", "scripts/seed/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "bots/blue-liquidation": {
      "entry": ["src/index.ts", "scripts/*.ts"]
    }
  }
}
