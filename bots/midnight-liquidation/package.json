  "dependencies": {
    "@repo/bot-kit": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/swaps": "workspace:*",
    "@repo/utils": "workspace:*",
    "executooor-viem": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
