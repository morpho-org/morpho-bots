{
  "name": "@morpho-org/midnight-liquidation",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "deploy:railway": "bun run scripts/deploy-railway.ts",
    "seed:positions": "bun run scripts/seed-liquidatable-positions.ts",
    "prestart": "bun run --parallel --workspaces --if-present build",
