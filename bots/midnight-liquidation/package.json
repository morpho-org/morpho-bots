{
  "name": "@morpho-org/midnight-liquidation",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "deploy:railway": "tsx scripts/deploy-railway.ts",
    "seed:positions": "pnpm run build && node dist/scripts/seed-liquidatable-positions.js",
    "prestart": "pnpm -r --if-present run build",
    "start": "node dist/src/index.js",
    "typecheck": "soltag && tsc --noEmit",
    "build": "soltag && tsx scripts/build.ts"
  },
  "dependencies": {
    "@repo/bot-kit": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/swaps": "workspace:*",
    "@repo/utils": "workspace:*",
    "executooor-viem": "catalog:",
    "openapi-fetch": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "execa": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
