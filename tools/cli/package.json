    "commander": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "typescript": "catalog:"
  }
}
