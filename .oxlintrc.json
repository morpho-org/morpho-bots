{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["./packages/oxlint-plugin/src/index.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-console": "off",
    "no-shadow": "off",
    "typescript/no-extraneous-class": [
      "error",
      {
        "allowWithDecorator": true
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-explicit-any": "error",
    "typescript/await-thenable": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "unicorn/consistent-function-scoping": "off",
    "eqeqeq": ["error", "always"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "import/no-default-export": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "complexity": "error",
    "max-depth": [
      "error",
      {
        "max": 3
      }
    ],
    "repo/comment-hygiene": "error",
    "repo/error-class-file": "error",
    "repo/no-as-address": "error",
    "repo/no-hex-template": "error",
    "repo/no-local-math-constant": "error",
    "repo/no-pow10-bigint": "error",
    "repo/require-checksum-address": "error",
    "repo/test-under-test-dir": "error",
    "repo/utils-apart-from-classes": "error",
    "repo/copy-style": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/generated",
    "pnpm-lock.yaml",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.js"
  ],
  "overrides": [
    {
      "files": ["**/vitest.config.ts", "packages/oxlint-plugin/src/index.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/test/**"],
      "rules": {
        "typescript/only-throw-error": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "repo/no-as-address": "off",
        "repo/error-class-file": "off",
        "typescript/no-explicit-any": "off",
        "repo/no-local-math-constant": "off",
        "repo/require-checksum-address": "off"
      }
    },
    {
      "files": ["**/scripts/**"],
      "rules": {
        "repo/no-local-math-constant": "off"
      }
    },
    {
      "files": ["bots/monitor-bot/**"],
      "rules": {
        "repo/utils-apart-from-classes": "off",
        "repo/copy-style": "off",
        "eslint/complexity": "off",
        "eslint/max-depth": "off"
      }
    },
    {
      "files": ["packages/oxlint-plugin/test/**"],
      "rules": {
        "repo/copy-style": "off"
      }
    }
  ]
}
