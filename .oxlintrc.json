{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/oxlint-config/base.json"],
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/generated",
    "bun.lock",
    "**/*.cjs",
    "**/*.mjs",
    "**/*.js"
  ]
}
